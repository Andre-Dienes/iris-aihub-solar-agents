# Copy to docker/.env and adjust.
# Tag of the IRIS AI Hub EAP image loaded with `docker load -i ...`
IRIS_IMAGE=intersystems/irishealth-community:2026.3.0AI.136.0
IRIS_PORT=1972
IRIS_WEB_PORT=52773
MCP_PORT=8888
# Optional: without a key the demo runs in offline mode (deterministic, no LLM calls)
OPENAI_API_KEY=
